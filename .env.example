# Local development only. These values are not production secrets.
# Copy this file to `.env` at the repository root. Do not commit `.env`.
#
# The backend reads the root `.env`. Do not put secrets in `frontend/.env`:
# Vite inlines every VITE_ variable into the browser bundle.

APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://procureflow:procureflow@127.0.0.1:5432/procureflow
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# mock: deterministic local provider, no network call. This is the default.
# openai: a live investigation only when INVESTIGATION_LIVE_ENABLED=true
# and OPENAI_API_KEY is set on the server. Leave the live flag false.
AI_MODE=mock
OPENAI_MODEL=gpt-5.4-mini
# OPENAI_API_KEY=
# OPENAI_REQUEST_TIMEOUT_SECONDS=30
# Price-table estimate for gpt-5.4-mini. Not a provider invoice.
# Application budgets are estimated safeguards, not guaranteed provider billing caps.
# OPENAI_INPUT_USD_PER_MILLION=0.75
# OPENAI_OUTPUT_USD_PER_MILLION=4.50

# Investigation budgets. The mock records zero tokens. The cost ceiling is
# an estimate, not a guaranteed spending cap. A live call also needs the
# flag below. Leave it false.
# INVESTIGATION_MAX_ITERATIONS=8
# INVESTIGATION_MAX_TOOL_CALLS=12
# INVESTIGATION_MAX_LLM_REQUESTS=6
# INVESTIGATION_MAX_OUTPUT_TOKENS=1200
# INVESTIGATION_TIMEOUT_SECONDS=90
# INVESTIGATION_MAX_ESTIMATED_COST_USD=0.10
# INVESTIGATION_LIVE_ENABLED=false

# Document intake. mock is a deterministic test double and makes no model call.
# openai also needs AI_MODE=openai, EXTRACTION_LIVE_ENABLED=true, and
# OPENAI_API_KEY. That budget is separate from the investigation budget.
# Leave the live flag false. OCR is not implemented.
DOCUMENT_EXTRACTOR=mock
# DOCUMENT_STORAGE_DIR=
# DOCUMENT_MAX_BYTES=10485760
# DOCUMENT_MAX_PAGES=20
# EXTRACTION_LIVE_ENABLED=false
# EXTRACTION_MAX_OUTPUT_TOKENS=2000
# EXTRACTION_MAX_ESTIMATED_COST_USD=0.05
# EXTRACTION_REQUEST_TIMEOUT_SECONDS=20
